library(Seurat)
library(dplyr)

# 1. Read Seurat object
matrix <- readRDS("matrix.rds")

# 2. Keep only Hip-seq samples
hip <- subset(matrix, Methods == "Hip-seq") 
Idents(hip) <- "group"

# 3. Define comparisons: format c(treatment, control)
comparisons <- list(
  DEG_Re  = c("Re48", "N48"),  
  DEG_NRe = c("NRe48", "N48")  
)

# 4. Run differential expression analysis
for (name in names(comparisons)) {
  ident.1 <- comparisons[[name]][1]
  ident.2 <- comparisons[[name]][2]
  
  cat("Running DE analysis:", name, " (", ident.1, " vs ", ident.2, ")\n", sep = "")
  
  deg <- FindMarkers(
    object = hip,
    ident.1 = ident.1,
    ident.2 = ident.2,
    min.pct = 0,                   
    logfc.threshold = 0,           
    test.use = "wilcox",
    verbose = FALSE
  )
  
  deg <- deg %>% mutate(gene = rownames(deg))
  write.csv(deg, file = paste0(name, "_all.csv"), row.names = FALSE)
}
