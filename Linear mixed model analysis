# ------------------------- 1. Load required packages -------------------------

library(lme4)       
library(lmerTest)   
library(performance)
library(ggplot2)    
library(dplyr)      

# Suppress scientific notation for cleaner output
options(scipen = 999)

# ------------------------- 2. Input data and reshape to long format -------------------------

# Raw data: left and right axon regeneration lengths
left  <- c(123.4, 361.1, 231.1, 177.1, 172.4, 253.8, 20.1, 515.1, 408.2, 112.7)
right <- c(386.6, 295.5, 331.8, 213.4, 234.2, 262.7, 422.1, 285.5, 346.8, 351.5)

# Build a long-format data frame (required for mixed models)
df <- data.frame(
  Fish_ID = factor(rep(1:10, each = 2)),         
  Side    = factor(rep(c("Left", "Right"), times = 10)), 
  Length  = c(left, right)                        
)

# Set reference level to "Left" so that the model output shows "Right" vs "Left"
df$Side <- relevel(df$Side, ref = "Left")

# Preview first 6 rows
print("Preview of the first 6 rows:")
print(head(df))

# ------------------------- 3. Fit the linear mixed model -------------------------

# Model formula: Length ~ Side + (1 | Fish_ID)
# Estimates the average fixed effect of side, while allowing each fish's baseline (intercept) to vary randomly
model <- lmer(Length ~ Side + (1 | Fish_ID), data = df)

# ------------------------- 4. Extract core statistical results -------------------------

cat("\n========== 1. Fixed effects (side influence) ==========\n")
summary_fixed <- summary(model)$coefficients
print(summary_fixed)

# Extract p-value for side effect
p_value_side <- summary_fixed["SideRight", "Pr(>|t|)"]
cat("\nP-value for right vs left difference =", p_value_side, "\n")
if (p_value_side < 0.05) {
  cat("Conclusion: Side has a significant effect on regeneration length (P < 0.05)\n")
} else {
  cat("Conclusion: Side effect is not significant (P > 0.05), but note the small sample size\n")
}

cat("\n========== 2. Random-effect variance decomposition (individual differences vs intrinsic stochasticity) ==========\n")
random_var <- as.data.frame(VarCorr(model))
print(random_var)

# Compute ICC manually
var_fish <- random_var[1, "vcov"]   # Variance due to fish (individual differences)
var_resid <- random_var[2, "vcov"]  # Residual variance (intrinsic stochasticity)
icc_manual <- var_fish / (var_fish + var_resid)
cat("\nManual ICC (proportion of total variance due to fish) =", round(icc_manual, 3), "\n")
cat("This means:", round(icc_manual*100, 1), "% of the random variance comes from fish-to-fish differences;",
    round((1-icc_manual)*100, 1), "% comes from intrinsic axon regrowth stochasticity.\n")

cat("\n========== 3. Model R² ==========\n")
r2_results <- r2_nakagawa(model)
print(r2_results)
cat("\nInterpretation:\n")
cat(" - Marginal R² =", round(r2_results$R2_marginal, 3), 
    "(variance explained by the fixed effect of side only)\n")
cat(" - Conditional R² =", round(r2_results$R2_conditional, 3), 
    "(variance explained by side + individual differences together)\n")

# ----------------------------------------------------------------------
# Additional analysis for branch number (same structure)
# ----------------------------------------------------------------------

library(lme4)
library(lmerTest)
library(performance)
library(ggplot2)

# Raw data for branch numbers (paired)
left_branch  <- c(1, 2, 2, 3, 3, 2, 1, 2, 3, 1)
right_branch <- c(1, 2, 2, 4, 1, 3, 2, 2, 2, 3)

# ---- 1. Reshape to long format ----
df_branch <- data.frame(
  Fish_ID = factor(rep(1:10, each = 2)),
  Side    = factor(rep(c("Left", "Right"), times = 10)),
  Branch  = c(rbind(left_branch, right_branch))   
)
df_branch$Side <- relevel(df_branch$Side, ref = "Left")

# Verify means
print("Descriptive statistics for branch numbers:")
tapply(df_branch$Branch, df_branch$Side, mean)

# ---- 2. Paired t-test ----
t.test(left_branch, right_branch, paired = TRUE)

# ---- 3. Linear mixed model ----
model_lmm <- lmer(Branch ~ Side + (1 | Fish_ID), data = df_branch)
summary(model_lmm)
VarCorr(model_lmm)
icc(model_lmm)
r2_nakagawa(model_lmm)

# ---- 4. Poisson GLMM (more appropriate for count data) ----
model_pois <- glmer(Branch ~ Side + (1 | Fish_ID), data = df_branch, family = poisson)
summary(model_pois)
