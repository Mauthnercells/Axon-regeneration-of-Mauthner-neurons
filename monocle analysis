library(monocle)
library(patchwork)
library(Seurat)
library(dplyr)
library(ggplot2)
library(viridis)
library(anndata)

# ============================================================
# 1. Theme settings
# ============================================================
my_text <- theme(
  text = element_text(size = 8, family = 'sans'),
  axis.text = element_text(color = 'black', size = 8)
)
my_legend <- theme(
  legend.key.size = unit(0.25, 'cm'),
  legend.text = element_text(size = 8, family = 'sans'),
  legend.title = element_text(size = 8),
  legend.box.spacing = unit(0, 'cm')
)
my_axis <- theme(
  axis.line = element_line(color = "black", size = 0.25, linetype = "solid"),
  axis.ticks = element_line(color = "black", linewidth = 0.25, linetype = "solid")
)

group_col <- c(
  N2 = "#F8766D", I2 = "#A3A500",
  N48 = "#00BF7D", NRe48 = "#8494FF", Re48 = "#E76BF3"
)

# ============================================================
# 2. Prepare data and build Monocle object
# ============================================================
seo_sub <- readRDS('matrix.rds')

seo_sub <- seo_sub
  NormalizeData(.) %>%
  FindVariableFeatures(., selection.method = "vst", nfeatures = 1000) %>%
  ScaleData(.) %>%
  RunPCA(., features = VariableFeatures(.), npcs = 30)

# Extract count matrix
expr_matrix <- as(as.matrix(seo_sub@assays$RNA@counts), 'sparseMatrix')

Idents(seo_sub) <- 'group'
seo_sub$names <- NULL

# Phenotype data
p_data <- seo_sub@meta.data
p_data$celltype <- Idents(seo_sub)

# Feature data
f_data <- data.frame(
  gene_short_name = row.names(seo_sub@assays$RNA@counts),
  row.names = row.names(seo_sub@assays$RNA@counts)
)

pd <- new('AnnotatedDataFrame', data = p_data)
fd <- new('AnnotatedDataFrame', data = f_data)

# Create Monocle cell data set
cds <- newCellDataSet(
  expr_matrix,
  phenoData = pd,
  featureData = fd,
  lowerDetectionLimit = 0.5,
  expressionFamily = negbinomial.size()
)

validObject(cds)

# Estimate size factors and dispersions
cds <- estimateSizeFactors(cds)
cds <- estimateDispersions(cds)

# Detect genes
cds <- detectGenes(cds, min_expr = 0.1)

# ============================================================
# 3. Identify ordering genes
# ============================================================
# Differential expression test across cell types
expressed_genes <- express_genes
diff <- differentialGeneTest(
  cds[expressed_genes, ],
  fullModelFormulaStr = "~celltype",
  cores = 24
)

deg <- subset(diff, qval < 0.05)
deg <- deg[order(deg$qval, decreasing = FALSE), ]

# Set ordering genes
ordergene <- rownames(deg)
cds <- setOrderingFilter(cds, ordergene)

plot_ordering_genes(cds)

# ============================================================
# 4. Dimensionality reduction and trajectory reconstruction
# ============================================================
cds <- reduceDimension(cds, max_components = 2, method = 'DDRTree')

# Order cells in pseudotime
cds <- orderCells(cds, reverse = TRUE)
cds <- orderCells(cds, reverse = TRUE, root_state = 2)

plot_cell_trajectory(cds, color_by = 'Pseudotime', size = 3)

# ============================================================
# 5. Transfer DDRTree embedding and pseudotime to Seurat object
# ============================================================
monocle2_reduct_df <- data.frame(t(reducedDimS(cds)))
colnames(monocle2_reduct_df) <- c('DDRTree_1', 'DDRTree_2')

seo_sub[["DDRTree"]] <- CreateDimReducObject(
  embeddings = as.matrix(monocle2_reduct_df),
  key = "DDRTree_",
  assay = 'RNA'
)
seo_sub@meta.data$Pseudotime <- cds$Pseudotime

# ============================================================
# 6. Plotting (reload saved object if needed)
# ============================================================

# 6.1 Group plot
p_group <- DimPlot(seo_sub, group.by = 'group', reduction = 'DDRTree',
                   pt.size = 1, shuffle = TRUE, order = 'NRe48') +
  scale_color_manual(values = c(
    N48 = group_col['N48'],
    NRe48 = group_col['NRe48'],
    Re48 = group_col['Re48']
  )) +
  labs(title = 'Group') +
  my_text + my_legend + my_axis +
  guides(color = guide_legend(override.aes = list(size = 0.5, alpha = 1))) +
  theme(
    axis.line = element_line(color = "black", size = 0.25, linetype = "solid"),
    axis.ticks = element_line(color = "black", linewidth = 0.25, linetype = "solid")
  )

ggsave("monocle_group.png",
       p_group, width = 6, height = 5.5, units = 'cm', dpi = 600)

# 6.2 Pseudotime plot
p1 <- FeaturePlot(seo_sub, reduction = 'DDRTree', pt.size = 1,
                  features = 'Pseudotime',
                  cols = viridis(100, begin = 0, end = 1, direction = 1)) +
  labs(title = 'Pseudotime') +
  my_text + my_axis +
  theme(
    legend.key.size = unit(0.25, 'cm'),
    axis.line = element_line(color = "black", size = 0.25, linetype = "solid"),
    axis.ticks = element_line(color = "black", linewidth = 0.25, linetype = "solid"),
    plot.title = element_text(size = 7, family = 'sans', face = 'plain')
  ) +
  scale_x_continuous(limits = c(-7.5, 5), breaks = seq(-7.5, 5, 3.5))

ggsave("monocle_pseud.png",
       p1, width = 6, height = 5.5, units = 'cm', dpi = 600)

# 6.3 Regeneration length plot
seo_sub2 <- seo_sub
seo_sub2@meta.data[which(seo_sub2$regeneration_length..μm. == 0), "regeneration_length..μm."] <- 1
seo_sub2@meta.data[is.na(seo_sub2$regeneration_length..μm.), "regeneration_length..μm."] <- 0

p_length <- FeaturePlot(seo_sub2, reduction = 'DDRTree', pt.size = 1.5,
                        features = 'regeneration_length..μm.',
                        cols = viridis(100, begin = 0, end = 1, direction = 1)) +
  labs(title = 'Regeneration length') +
  my_text + my_axis +
  theme(
    legend.key.size = unit(0.25, 'cm'),
    axis.line = element_line(color = "black", size = 0.25, linetype = "solid"),
    axis.ticks = element_line(color = "black", linewidth = 0.25, linetype = "solid")
  )

ggsave("monocle_length.png",
       p_length, width = 6, height = 6, units = 'cm', dpi = 600)
