#!/bin/sh
#an example for Intel MPI job.
#DO NOT RUN THIS SCRIPT DIRECTLY,
#PLEASE RUN THIS SCRIPT WITH qsub: qsub intelmpi_job.pbs
#
#PBS -N mapping_STAR
#PBS -o mapping.log
#PBS -e mapping.err
#PBS -q fat
#PBS -l nodes=1:ppn=10
#PBS -l walltime=148:00:00

module load STAR


for file in 'Injury_12hpi_1' 'Injury_12hpi_2' 'Injury_12hpi_3' 'Injury_12hpi_4' 'Injury_24hpi_1' 'Injury_24hpi_2' 'Injury_24hpi_3' 'Injury_24hpi_4' 'Injury_24hpi_5' 'Injury_2hpi_1' 'Injury_2hpi_2' 'Injury_2hpi_3' 'Injury_2hpi_4' 'Injury_2hpi_5' 'Injury_48hpi_1' 'Injury_48hpi_2' 'Injury_48hpi_3' 'Injury_48hpi_4' 'Injury_48hpi_5' 'Injury_6hpi_1' 'Injury_6hpi_2' 'Injury_6hpi_3' 'Injury_6hpi_4' 'Injury_6hpi_5' 'Injury_6hpi_6' 'Injury_72hpi_1' 'Injury_72hpi_2' 'Injury_72hpi_3' 'Injury_72hpi_4' 'Injury_96hpi_1' 'Injury_96hpi_2' 'Injury_96hpi_3' 'Normal_12hpi_1' 'Normal_12hpi_2' 'Normal_12hpi_3' 'Normal_12hpi_4' 'Normal_24hpi_1' 'Normal_24hpi_2' 'Normal_24hpi_3' 'Normal_24hpi_4' 'Normal_24hpi_5' 'Normal_2hpi_1' 'Normal_2hpi_2' 'Normal_2hpi_3' 'Normal_2hpi_4' 'Normal_2hpi_5' 'Normal_48hpi_1' 'Normal_48hpi_2' 'Normal_48hpi_3' 'Normal_48hpi_4' 'Normal_48hpi_5' 'Normal_6hpi_1' 'Normal_6hpi_2' 'Normal_6hpi_3' 'Normal_6hpi_4' 'Normal_6hpi_5' 'Normal_6hpi_6' 'Normal_72hpi_1' 'Normal_72hpi_2' 'Normal_72hpi_3' 'Normal_72hpi_4' 'Normal_96hpi_1' 'Normal_96hpi_2' 'Normal_96hpi_3'

do
echo $file
STAR \
--runThreadN 10 \
--genomeDir /path_to_reference/reference \
--readFilesCommand gunzip -c \
--outFileNamePrefix /path_to_data/bam/${file}_clean.bam \
--outSAMtype BAM SortedByCoordinate \
--quantMode GeneCounts \
--readFilesIn /path_to_data/fastp/${file}_clean_1.fq.gz /path_to_data/fastp/${file}_clean_2.fq.gz
done


